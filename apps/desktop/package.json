{
  "name": "desktop",
  "version": "0.0.9",
  "private": true,
  "description": "Room Jukebox Windows desktop shell (Electron).",
  "author": "Jason Tucker",
  "license": "MIT",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "pnpm --filter web build && pnpm run bundle",
    "bundle": "node build.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "dist:win": "node ../../scripts/release-notes.mjs && pnpm run build && electron-builder --win --x64"
  },
  "dependencies": {
    "electron-updater": "6.8.10"
  },
  "devDependencies": {
    "@room-jukebox/shared": "workspace:*",
    "@types/multicast-dns": "7.2.4",
    "@types/node": "24.19.1",
    "electron": "44.7.0",
    "electron-builder": "26.17.0",
    "electron-log": "5.4.4",
    "esbuild": "0.28.2",
    "multicast-dns": "7.2.5",
    "server": "workspace:*",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
